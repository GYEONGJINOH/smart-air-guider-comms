// 이 파일을 secrets.h 로 복사한 뒤 실제 값으로 채우세요.
// secrets.h는 .gitignore에 포함되어 커밋되지 않습니다.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// MQTT 브로커 (예: HiveMQ Cloud 무료 클러스터 - TLS 포트 8883)
#define MQTT_HOST "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_USERNAME "your-mqtt-username"
#define MQTT_PASSWORD "your-mqtt-password"

// 센서 노드 식별자. 노드가 여러 대일 경우 각 보드마다 다르게 설정.
#define NODE_ID "node-1"

// 발행 토픽: smart-air-guider/nodes/<NODE_ID>/sensor
#define MQTT_TOPIC_PREFIX "smart-air-guider/nodes/"
