# 이 파일을 .env 로 복사한 뒤 채우세요.

# MQTT 브로커 (센서 노드와 동일한 브로커)
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=smart-air-guider/nodes/+/sensor

# 이 프로세스가 프론트엔드에 GET/POST /sensor를 제공하는 포트
PORT=3000

# 장치가 MQTT 없이 직접 POST /sensor 할 때 검사할 키 (선택 사항, 비워두면 미검사)
DEVICE_API_KEY=
